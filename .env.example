# 飞书自建应用凭证（不要将真实 .env 提交到 Git）
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 腾讯位置服务 - JavaScript API GL 浏览器端 Key
VITE_TENCENT_MAP_KEY=xxxxxxxxxxxxxxxx

# 从「销售部门 / 表格 5」的多维表格 URL 取得 app_token 与 table_id。
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxxx

# 如表格 5 的列名与默认名称不同，在此填写实际列名。
FEISHU_FIELD_NAME=姓名
FEISHU_FIELD_PHONE=电话
FEISHU_FIELD_COMPANY=公司名称
FEISHU_FIELD_EMAIL=邮箱
FEISHU_FIELD_MESSAGE=留言内容

# 企业荣誉表：可使用同一多维表格 App Token，也可填写单独的 App Token。
FEISHU_HONORS_APP_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_HONORS_TABLE_ID=tblxxxxxxxxxxxxx
FEISHU_HONORS_FIELD_CATEGORY=分类
FEISHU_HONORS_FIELD_TITLE=荣誉名称
FEISHU_HONORS_FIELD_IMAGE=图片
FEISHU_HONORS_FIELD_ORDER=排序
FEISHU_HONORS_FIELD_PUBLISHED=官网展示
FEISHU_EVENT_VERIFICATION_TOKEN=replace-with-feishu-event-verification-token
FEISHU_HONORS_POLLING_ENABLED=true
FEISHU_HONORS_SYNC_INTERVAL_MS=300000
# 可选：默认使用项目目录下的 data/honors
FEISHU_HONORS_CACHE_DIR=data/honors

# 企业新闻表：飞书作为新闻内容的增删改查入口，本地缓存用于网站稳定读取。
# 必填：分别填写新闻多维表格 URL 中的 app_token 与 table_id；未配置时无法从飞书同步。
FEISHU_NEWS_APP_TOKEN=N8yHbyuThazjbOsePG1cPhbMnBb
FEISHU_NEWS_TABLE_ID=tblnrS0SfXKlDyay
# Optional bilingual columns. When present, the English page uses these values directly.
FEISHU_NEWS_FIELD_TITLE_EN=英文标题
FEISHU_NEWS_FIELD_SUMMARY_EN=English Summary
# When AI_TRANSLATION_URL is configured, missing bilingual values are translated during news sync.
FEISHU_NEWS_AUTO_TRANSLATE=true
FEISHU_NEWS_FIELD_TITLE=标题
FEISHU_NEWS_FIELD_DATE=发布日期
FEISHU_NEWS_FIELD_CATEGORY=分类
FEISHU_NEWS_FIELD_TAG=标签
FEISHU_NEWS_FIELD_SUMMARY=摘要
FEISHU_NEWS_FIELD_IMAGE=封面图
FEISHU_NEWS_FIELD_HOME_IMAGE=首页底栏新闻信息图
FEISHU_NEWS_FIELD_ORDER=排序
FEISHU_NEWS_FIELD_FEATURED=首页推荐
FEISHU_NEWS_FIELD_PUBLISHED=官网展示
FEISHU_NEWS_FIELD_LINK=详情链接
# 默认开启轮询，确保事件回调延迟或不可用时也会同步本地缓存
FEISHU_NEWS_POLLING_ENABLED=true
FEISHU_NEWS_SYNC_INTERVAL_MS=300000
FEISHU_NEWS_CACHE_DIR=data/news

# 本地 API 端口；Vite 已代理 /api 到 8787。
API_PORT=8787

# HTTPS：生产环境请使用由证书机构签发的 PEM 证书。开发环境可用 mkcert 生成本机可信证书。
# 启用后，Vite 开发服务和 Node API 都会使用 HTTPS；证书目录已被 Git 忽略。
HTTPS_ENABLED=false
HTTPS_KEY_PATH=certs/localhost-key.pem
HTTPS_CERT_PATH=certs/localhost.pem

# 联系表单防刷：默认按客户端地址限制。仅在可信反向代理后设置 TRUST_PROXY=true。
TRUST_PROXY=false
LEAD_RATE_LIMIT_WINDOW_MS=60000
LEAD_RATE_LIMIT_MAX=5
LEAD_BURST_WINDOW_MS=10000
LEAD_BURST_LIMIT_MAX=2
LEAD_MAX_CONCURRENT=8
LEAD_DUPLICATE_WINDOW_MS=120000
LEAD_BODY_MAX_BYTES=8192

# WeChat Official Account -> Feishu Bitable news sync (server-side only)
WECHAT_NEWS_SYNC_ENABLED=false
WECHAT_MP_APP_ID=wx_xxxxxxxxxxxxx
WECHAT_MP_APP_SECRET=xxxxxxxxxxxxxxxx
WECHAT_NEWS_SYNC_INTERVAL_MS=300000
WECHAT_NEWS_BATCH_SIZE=20
WECHAT_NEWS_MAX_ARTICLES=100
WECHAT_NEWS_CATEGORY=company
WECHAT_NEWS_TAG=微信公众号
WECHAT_SYNC_UPDATE_EXISTING=true
WECHAT_SYNC_TRIGGER_TOKEN=replace-with-a-random-server-token
# Optional, only needed if configuring the WeChat callback URL
WECHAT_CALLBACK_TOKEN=replace-with-wechat-callback-token
